{
  "about": "Записки и стихи для открыток. Клиент выбирает вариант по id или присылает свой текст. Записка — массив строк: одна строка = одна рукописная строка / один титр. Стихи — только классика с истёкшими правами или свои (author: \"свой\").",
  "occasions": {
    "sorry": "Извинение",
    "mom": "Маме",
    "just": "Просто так"
  },
  "notes": [
    { "id": "sorry-1", "occasion": "sorry", "title": "Как есть",
      "lines": ["Я был не прав.", "Не ищу слов получше —", "просто говорю как есть.", "Прости меня.", "Я рядом, если позовёшь."] },
    { "id": "sorry-2", "occasion": "sorry", "title": "Вместо слов",
      "lines": ["Вчера я сказал лишнее.", "Сегодня молчу", "и несу цветы —", "они умеют лучше.", "Прости."] },
    { "id": "sorry-3", "occasion": "sorry", "title": "Две чашки",
      "lines": ["Чайник поставлен,", "две чашки на столе.", "Вторая ждёт тебя.", "Мне жаль, что так вышло.", "Давай начнём с чая."] },
    { "id": "sorry-4", "occasion": "sorry", "title": "После дождя",
      "lines": ["Мы оба устали,", "а сорвался я.", "Это не про тебя.", "Прости.", "После дождя всегда светлее."] },
    { "id": "sorry-5", "occasion": "sorry", "title": "Коротко",
      "lines": ["Прости.", "Я скучаю.", "И я всё понял."] },

    { "id": "mom-1", "occasion": "mom", "title": "Свет в окне",
      "lines": ["Мама,", "спасибо за тёплые руки", "и за свет в окне,", "когда я возвращался поздно.", "Я помню."] },
    { "id": "mom-2", "occasion": "mom", "title": "Не по телефону",
      "lines": ["Давно хотел сказать это", "не по телефону:", "ты — мой самый тихий дом.", "Люблю."] },
    { "id": "mom-3", "occasion": "mom", "title": "Как доедешь",
      "lines": ["Пирог по воскресеньям,", "записки в кармане куртки", "и твоё «позвони, как доедешь».", "Доехал. Звоню.", "Люблю."] },
    { "id": "mom-4", "occasion": "mom", "title": "Без повода",
      "lines": ["Без повода.", "Просто цветы —", "потому что ты есть.", "Поставь их на подоконник,", "пусть смотрят на сад."] },
    { "id": "mom-5", "occasion": "mom", "title": "Отдохни",
      "lines": ["Мама, отдохни сегодня.", "Не готовь, не волнуйся.", "Просто посиди с цветами.", "Я приеду вечером."] },

    { "id": "just-1", "occasion": "just", "title": "Ничего не случилось",
      "lines": ["Ничего не случилось.", "Просто увидел цветы", "и подумал о тебе."] },
    { "id": "just-2", "occasion": "just", "title": "Среда",
      "lines": ["Среда. Обычный день.", "Пусть в нём будет", "что-то необычное —", "вот это."] },
    { "id": "just-3", "occasion": "just", "title": "Туман",
      "lines": ["Утром был туман,", "потом солнце.", "Хотел, чтобы у тебя", "было так же."] },
    { "id": "just-4", "occasion": "just", "title": "Не дата",
      "lines": ["Не праздник, не дата.", "Просто ты —", "и этого достаточно."] },
    { "id": "just-5", "occasion": "just", "title": "Кто-то думает",
      "lines": ["Пусть стоят на столе", "и напоминают:", "кто-то о тебе думает.", "Это я."] }
  ],
  "poems": [
    { "id": "p-tyutchev-slovo", "occasions": ["sorry"], "author": "Фёдор Тютчев", "title": "«Нам не дано предугадать…»", "year": 1869, "excerpt": false,
      "stanzas": [["Нам не дано предугадать,", "Как слово наше отзовётся, —", "И нам сочувствие даётся,", "Как нам даётся благодать…"]] },
    { "id": "p-blok-doblesti", "occasions": ["sorry"], "author": "Александр Блок", "title": "«О доблестях, о подвигах, о славе…»", "year": 1908, "excerpt": true,
      "stanzas": [["О доблестях, о подвигах, о славе", "Я забывал на горестной земле,", "Когда твоё лицо в простой оправе", "Передо мной сияло на столе."]] },
    { "id": "p-pushkin-lyubil", "occasions": ["sorry"], "author": "Александр Пушкин", "title": "«Я вас любил…»", "year": 1829, "excerpt": false,
      "note": "Скорее прощание, чем извинение — предлагать осторожно.",
      "stanzas": [["Я вас любил: любовь ещё, быть может,", "В душе моей угасла не совсем;", "Но пусть она вас больше не тревожит;", "Я не хочу печалить вас ничем."],
                  ["Я вас любил безмолвно, безнадежно,", "То робостью, то ревностью томим;", "Я вас любил так искренно, так нежно,", "Как дай вам бог любимой быть другим."]] },

    { "id": "p-own-kitchen", "occasions": ["mom"], "author": "свой", "title": "Кухня", "year": 2026, "excerpt": false,
      "stanzas": [["На кухне свет. Ещё темно.", "Негромко чайник запевает.", "Ты смотришь в зимнее окно —", "так смотрят те, кто ожидает."],
                  ["Я вырос. Город стал другим,", "и адрес мой давно не этот.", "Но в этом свете — я твоим", "и остаюсь. Зимой и летом."]] },
    { "id": "p-esenin-pismo", "occasions": ["mom"], "author": "Сергей Есенин", "title": "Письмо матери", "year": 1924, "excerpt": true,
      "stanzas": [["Ты жива ещё, моя старушка?", "Жив и я. Привет тебе, привет!", "Пусть струится над твоей избушкой", "Тот вечерний несказанный свет."],
                  ["Пишут мне, что ты, тая тревогу,", "Загрустила шибко обо мне,", "Что ты часто ходишь на дорогу", "В старомодном ветхом шушуне."]] },
    { "id": "p-pushkin-nyane", "occasions": ["mom"], "author": "Александр Пушкин", "title": "Няне", "year": 1826, "excerpt": true,
      "stanzas": [["Подруга дней моих суровых,", "Голубка дряхлая моя!", "Одна в глуши лесов сосновых", "Давно, давно ты ждёшь меня."]] },

    { "id": "p-fet-shepot", "occasions": ["just"], "author": "Афанасий Фет", "title": "«Шёпот, робкое дыханье…»", "year": 1850, "excerpt": false,
      "stanzas": [["Шёпот, робкое дыханье,", "Трели соловья,", "Серебро и колыханье", "Сонного ручья,"],
                  ["Свет ночной, ночные тени,", "Тени без конца,", "Ряд волшебных изменений", "Милого лица,"],
                  ["В дымных тучках пурпур розы,", "Отблеск янтаря,", "И лобзания, и слёзы,", "И заря, заря!.."]] },
    { "id": "p-fet-privet", "occasions": ["just"], "author": "Афанасий Фет", "title": "«Я пришёл к тебе с приветом…»", "year": 1843, "excerpt": true,
      "stanzas": [["Я пришёл к тебе с приветом,", "Рассказать, что солнце встало,", "Что оно горячим светом", "По листам затрепетало;"]] },
    { "id": "p-pushkin-utro", "occasions": ["just"], "author": "Александр Пушкин", "title": "Зимнее утро", "year": 1829, "excerpt": true,
      "stanzas": [["Мороз и солнце; день чудесный!", "Ещё ты дремлешь, друг прелестный —", "Пора, красавица, проснись:", "Открой сомкнуты негой взоры", "Навстречу северной Авроры,", "Звездою севера явись!"]] },
    { "id": "p-lermontov-doroga", "occasions": ["just"], "author": "Михаил Лермонтов", "title": "«Выхожу один я на дорогу…»", "year": 1841, "excerpt": true,
      "stanzas": [["Выхожу один я на дорогу;", "Сквозь туман кремнистый путь блестит;", "Ночь тиха. Пустыня внемлет богу,", "И звезда с звездою говорит."]] }
  ]
}
